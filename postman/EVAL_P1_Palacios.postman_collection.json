          "mode": "raw",
          "raw": "{\n  \"email\": \"paulo.galarza@example.com\",\n  \"password\": \"incorrecta\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "08 Auth - protected con token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/protected-route"
